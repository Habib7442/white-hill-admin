# Sanity: the same project and dataset as the public site
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Public website URL (no trailing slash), for "View on site" links. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://whitehilllifecares.com

# Server only. Never prefix these with NEXT_PUBLIC_.
# Sanity Editor token (sanity.io/manage -> API -> Tokens), e.g. named "admin-panel"
SANITY_API_WRITE_TOKEN=

# Same value as the website's SANITY_REVALIDATE_SECRET (and the Sanity webhook secret).
# The admin uses it to tell the website to refresh right after each save.
SANITY_REVALIDATE_SECRET=

# Admin login. No signup: change these and redeploy to change the login.
ADMIN_EMAIL=
# Output of: npm run hash-password -- "your-password"  (base64 bcrypt hash)
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
